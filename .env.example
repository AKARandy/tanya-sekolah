# ============================================================
# Sekolah Assistant - LLM backend configuration
# Copy this file to .env and fill in ONE backend below.
# All backends speak the OpenAI API protocol.
# ============================================================

# Which provider preset to use:
#   groq        - free tier, fast Llama 3.3 70B        (recommended demo)
#   openrouter  - free tier, many models
#   ollama      - local, no API key needed
#   qwen-kaggle - YOUR Qwen server via zrok tunnel (see Qwen-on-Kaggle-via-zrok-and-API)
#   openai      - paid OpenAI
#   custom      - any OpenAI-compatible URL (set LLM_BASE_URL + LLM_MODEL)
LLM_PROVIDER=groq

# API key for the chosen provider (groq: console.groq.com, openrouter: openrouter.ai).
# Leave empty for ollama and qwen-kaggle.
LLM_API_KEY=

# Optional: override the provider preset's base URL and model.
# Examples:
#   qwen-kaggle: LLM_BASE_URL=https://<your-zrok-subdomain>.share.zrok.io/v1
#   custom:      LLM_BASE_URL=http://localhost:1234/v1  (LM Studio etc.)
LLM_BASE_URL=
LLM_MODEL=

# --- Embeddings (for the vector RAG route) ---
# fastembed model id (Indonesian-capable). Light default; e5-large is stronger but heavier.
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
